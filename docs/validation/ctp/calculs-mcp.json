          "type": "number",
          "description": "Volume mensuel de tâches."
        },
        "t_horizon": {
          "type": "integer",
          "description": "Horizon en mois (1 à 120)."
        },
        "c_orch": {
          "type": "number",
          "description": "Coût mensuel d'orchestration, en euros."
        },
        "kappa": {
          "type": "number",
          "description": "Coefficient multiplicateur de la couche d'orchestration."
        },
        "w": {
          "type": "number",
          "description": "Coût horaire chargé de l'humain, en euros."
        },
        "h1": {
          "type": "number",
          "description": "Heures humaines totales par mois de calibrage."
        },
        "h2": {
          "type": "number",
          "description": "Heures humaines totales par mois après le calibrage."
        },
        "calibration_months": {
          "type": "integer",
          "description": "Durée du calibrage, entière de 0 à 120 mois (3 par défaut)."
        },
        "detail": {
          "type": "string",
          "description": "'totaux' (par défaut) renvoie C1, C2, C3 et CTP cumulés ; 'mensuel' ajoute la série mois par mois.",
          "enum": [
            "totaux",
            "mensuel"
          ]
        }
